# ===================================================================
# SIV Cleaning - SMTP & Email Configuration (Nodemailer)
# ===================================================================
# Copy this file to .env.local and fill in your actual credentials.

# SMTP Server Host (e.g. smtp.gmail.com, smtp.office365.com, mail.sivcleaning.com.au)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=587

# Set to true if using port 465, false for 587
SMTP_SECURE=false

# SMTP Username / Authentication email
SMTP_USER=info@sivcleaning.com.au

# SMTP Password (for Gmail, generate an "App Password" under Google Account Security)
SMTP_PASS=your-email-password-or-app-password

# Default 'From' header shown to recipients
SMTP_FROM="SIV Cleaning <info@sivcleaning.com.au>"

# Destination email address where all user quotes will be sent
SMTP_TO=info@sivcleaning.com.au
